nio": 351, "homicidio_qualificado": 5946}, {"uf": "MS", "estupro": 342, "estupro_vulneravel": 1200, "latrocinio": 166, "homicidio_qualificado": 847}, {"uf": "MT", "estupro": 6, "estupro_vulneravel": 50, "latrocinio": 9, "homicidio_qualificado": 122}, {"uf": "PA", "estupro": 980, "estupro_vulneravel": 2189, "latrocinio": 925, "homicidio_qualificado": 2333}, {"uf": "PB", "estupro": 238, "estupro_vulneravel": 445, "latrocinio": 269, "homicidio_qualificado": 1473}, {"uf": "PE", "estupro": 772, "estupro_vulneravel": 1053, "latrocinio": 1647, "homicidio_qualificado": 4255}, {"uf": "PI", "estupro": 236, "estupro_vulneravel": 702, "latrocinio": 274, "homicidio_qualificado": 1237}, {"uf": "PR", "estupro": 801, "estupro_vulneravel": 2332, "latrocinio": 554, "homicidio_qualificado": 1296}, {"uf": "RJ", "estupro": 151, "estupro_vulneravel": 615, "latrocinio": 55, "homicidio_qualificado": 337}, {"uf": "RN", "estupro": 6, "estupro_vulneravel": 53, "latrocinio": 17, "homicidio_qualificado": 78}, {"uf": "RO", "estupro": 177, "estupro_vulneravel": 622, "latrocinio": 82, "homicidio_qualificado": 344}, {"uf": "RR", "estupro": 148, "estupro_vulneravel": 296, "latrocinio": 89, "homicidio_qualificado": 432}, {"uf": "RS", "estupro": 1154, "estupro_vulneravel": 6612, "latrocinio": 1256, "homicidio_qualificado": 1844}, {"uf": "SC", "estupro": 1008, "estupro_vulneravel": 3223, "latrocinio": 1196, "homicidio_qualificado": 3711}, {"uf": "SE", "estupro": 355, "estupro_vulneravel": 143, "latrocinio": 158, "homicidio_qualificado": 1273}, {"uf": "SP", "estupro": 4626, "estupro_vulneravel": 10521, "latrocinio": 4890, "homicidio_qualificado": 10327}, {"uf": "TO", "estupro": 106, "estupro_vulneravel": 361, "latrocinio": 96, "homicidio_qualificado": 337}], "demografia_prisional": {"raca_informada": 821528, "negros": 571822, "negros_pct": 0.696, "brancos": 239933, "raca_nao_informada": 102991, "instrucao_informada": 809443, "ate_fundamental_incompleto": 402619, "ate_fundamental_pct": 0.4974, "superior_completo": 9654, "superior_completo_pct": 0.0119, "analfabetos": 17631}, "o_que_nao_existe": {"titulo": "O que o Estado brasileiro não sabe sobre quem agride uma criança", "itens": [{"campo": "Cor ou raça do agressor", "situacao": "Não coletado no SINAN. No SISDEPEN existe para a população prisional INTEIRA, mas nunca cruzado com o tipo penal."}, {"campo": "Escolaridade do agressor", "situacao": "Idem: existe para o conjunto dos presos, não para quem responde por crime sexual."}, {"campo": "Renda ou faixa econômica", "situacao": "Não existe em nenhuma das duas bases. Zero colunas nas 1.737 do SISDEPEN."}, {"campo": "Profissão ou cargo", "situacao": "O SINAN registra a ocupação da VÍTIMA (ID_OCUPA_N), nunca a do agressor. O SISDEPEN não registra a de ninguém."}, {"campo": "Religião", "situacao": "Não existe em nenhuma base pública brasileira sobre autores de violência. O SINAN só registra intolerância religiosa como MOTIVAÇÃO da agressão — 18 casos no país em 2024, entre 164 mil."}, {"campo": "Reincidência", "situacao": "Zero colunas no SISDEPEN. O SINAN mede repetição contra a MESMA vítima (OUT_VEZES), não o histórico do autor."}], "conclusao": "O que se pode dizer com dado público sobre o agressor de uma criança se resume a três atributos: o VÍNCULO com a vítima, o SEXO e a FAIXA ETÁRIA. Tudo o mais — cor, escolaridade, renda, ocupação, religião, reincidência — não é sigiloso: simplesmente não é perguntado. Um perfil socioeconômico do agressor sexual brasileiro não está escondido; ele nunca foi construído."}, "aviso_metodologico": "O SISDEPEN é preenchido por ESTABELECIMENTO, não por pessoa. As incidências por tipo penal e a demografia da população prisional são contagens paralelas da mesma unidade, nunca cruzadas na origem. Combinar as duas para estimar a cor ou a escolaridade de quem responde por crime sexual seria falácia ecológica — o número sairia, e seria inventado. Por isso os dois blocos aparecem separados aqui.", "nota_incidencias": "São INCIDÊNCIAS penais, não pessoas: alguém que responde por dois artigos é contado duas vezes. E incluem presos provisórios — nem toda incidência é condenação transitada em julgado."}